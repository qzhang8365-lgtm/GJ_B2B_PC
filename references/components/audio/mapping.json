    "progress": ".gj-audio-progress input[type=range]",
    "volume": ".gj-audio-volume-slider input[type=range]",
    "mute": "button.gj-audio-volume-icon[data-action=mute]；.is-muted / aria-pressed 同步静音，恢复最近非零音量"
  },
  "tokenMap": {
    "mini": "--ds-component-audio-mini-*",
    "progress": "--ds-component-audio-progress-*",
    "listItem": "--ds-component-audio-list-item-*",
    "full": "--ds-component-audio-full-*",
    "volume": "--ds-component-audio-volume-*",
    "toggle": "--ds-component-audio-toggle-*"
  },
