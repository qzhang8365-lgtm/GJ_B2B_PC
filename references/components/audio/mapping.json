  "implementation": {
    "sharedCss": "assets/styles/gj-b2b-components.css",
    "sharedTokens": "assets/styles/gj-b2b-tokens.css",
    "runtime": "assets/scripts/gj-audio.js",
    "preview": "preview/audio/index.html",
    "legacyAlias": ".gj-audio-bar 继续兼容旧 Mini 标记，新增页面优先使用 .gj-audio-mini。"
  },
  "behavior": {
    "runtimeRoot": "[data-gj-audio]",
    "stateClass": ".is-playing",
    "events": [
      "gj-audio-statechange",
      "gj-audio-prev",
      "gj-audio-next",
      "gj-audio-close"
    ],
    "nativeMedia": "可选 audio.gj-audio-media；缺省时预览运行时模拟播放。",
    "responsive": "Mini按自身容器宽度：小于520px隐藏时间戳，小于340px再隐藏时长；控制和进度保持可操作。"
  }
