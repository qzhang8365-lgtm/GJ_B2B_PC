    "reviewedAt": "2026-10-29",
    "figmaContext": "5404:933",
    "figmaThumb": "5404:917",
    "size": 6,
    "fill": "Brand/GJ_Blue",
    "cssVariable": "--ds-component-audio-volume-thumb-background"
  },
  "iconMap": {
    "previous": "icf_media_skip-previous-fill.svg",
    "next": "icf_media_skip-forward-fill.svg",
    "mini.play": "icf_media_play-triangle-fill.svg",
    "mini.pause": "icf_media_pause-regular.svg",
    "list.hover": "icf_media_play_fill.svg",
    "full.play": "icf_media_play-triangle-fill.svg",
    "full.pause": "icf_media_pause-fill.svg",
    "volume": "icf_media_volume-down-fill.svg",
    "volume.muted": "icf_media_volumeoff-fill.svg（.gj-audio-volume-icon.is-muted，音量0或媒体muted=true）",
