      "cssVariable": "--ds-component-checkbox-group-gap",
      "range": {
        "min": "{Interval/space6}",
        "max": "{Interval/space7}",
        "resolvedMin": 20,
        "resolvedMax": 24
      },
      "note": "CHK-003 已关闭（2026-09-08 设计确认）：Figma Group 间距允许在 20-24px 区间内浮动，非单一固定值；默认取区间下限 20px，可按信息密度在 20-24px 内选取，不再使用旧值 16px。"
    },
    "focus.ringWidth": {
      "value": 3,
      "unit": "px",
      "cssVariable": "--ds-component-checkbox-focus-ring-width"
