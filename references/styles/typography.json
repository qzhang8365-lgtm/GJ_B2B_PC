{
  "$schema": "gj-design-skill/typography-styles/v1",
  "source": "Figma local Text Styles",
  "letterSpacingTokens": {
    "font.letterSpacing.0": {
      "value": 0,
      "unit": "px",
      "cssVariable": "--font-letter-spacing-0",
      "usage": "中文正文、按钮、表格、普通数字"
    },
    "font.letterSpacing.tight": {
      "value": -0.2,
      "unit": "px",
      "cssVariable": "--font-letter-spacing-tight",
      "usage": "超大数字指标，可选使用",
      "optional": true
    }
  },
  "numericTypographyTokens": {
    "font.numeric.tabular": {
      "value": "tabular-nums",
      "cssProperty": "font-variant-numeric",
      "usage": "仅供 Metric、Gauge、Progress、Progress Ring 的 GJType 核心指标"
    },
    "font.feature.tnum": {
      "value": "tnum",
      "cssProperty": "font-feature-settings",
      "usage": "兼容部分字体的等宽数字能力"
    }
  },
  "styles": {
    "中文/S1-CN-S": {
      "fontFamily": "PingFang SC",
      "fontStyle": "Semibold",
      "fontWeight": 600,
      "fontSize": 24,
      "lineHeight": 32,
      "letterSpacing": "{font.letterSpacing.0}",
      "usage": "头部banner级标题",
      "cssClass": "gj-type-cn-s1"
    },
    "中文/S2-CN-S": {
      "fontFamily": "PingFang SC",
      "fontStyle": "Semibold",
      "fontWeight": 600,
      "fontSize": 20,
      "lineHeight": 30,
      "letterSpacing": "{font.letterSpacing.0}",
      "usage": "页面大标题",
      "cssClass": "gj-type-cn-s2"
    },
    "中文/S3-CN-S": {
      "fontFamily": "PingFang SC",
      "fontStyle": "Semibold",
      "fontWeight": 600,
      "fontSize": 18,
      "lineHeight": 26,
      "letterSpacing": "{font.letterSpacing.0}",
      "usage": "重要模块标题、分组标题、区块标题",
      "cssClass": "gj-type-cn-s3"
    },
    "中文/S4-CN-S": {
      "fontFamily": "PingFang SC",
      "fontStyle": "Semibold",
      "fontWeight": 600,
      "fontSize": 16,
      "lineHeight": 24,
